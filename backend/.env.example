# Local API configuration. Replace placeholders before connecting to PostgreSQL.
# dotnet run does not automatically load this file; export these values to the API process.
SCHOOL_BOT_DB_CONNECTION_STRING="Host=<db-host>;Port=9499;Database=<database>;Username=<username>;Password=<password>"

# Leave empty to keep PoC admin endpoints disabled.
SCHOOL_BOT_ADMIN_KEY=

SCHOOL_BOT_LOGOUT_RATE_LIMIT=30
SCHOOL_BOT_LOGOUT_WINDOW_SECONDS=60
SCHOOL_BOT_LOGOUT_CONCURRENCY_LIMIT=8
# Legacy PostgreSQL connections (optional; never commit real credentials).
MASTER_DB_CONNECTION_STRING="Host=<db-host>;Database=<master-db>;Username=<username>;Password=<password>"
SCHOOL_DB_CONNECTION_STRING="Host=<db-host>;Database=<school-db>;Username=<username>;Password=<password>"
LOGS_DB_CONNECTION_STRING="Host=<db-host>;Database=<logs-db>;Username=<username>;Password=<password>"
PGGRADE_DB_CONNECTION_STRING="Host=<db-host>;Database=<grade-db>;Username=<username>;Password=<password>"

# Required for persistent Curriculum/QuestionBank idempotency; base64 of a stable 32-byte key.
SCHOOL_BOT_REPLAY_KEY=
# To run without a database, explicitly select Memory in Development only.
# SchoolBot__Storage=Memory
# ASPNETCORE_ENVIRONMENT=Development
