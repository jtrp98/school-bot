{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School Bot engine manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "language", "protocol", "modes", "transport", "entrypoints", "hardware_platforms"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "type": "string", "minLength": 1 },
    "protocol": { "const": "1.0" },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "transport": { "const": "stdio-json-lines" },
    "default_device_transport": { "type": "string" },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["windows", "darwin", "linux"] },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
    },
    "hardware_platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["windows", "darwin", "linux"] } },
    "source": { "type": "string" },
    "integration": { "type": "string" }
  }
}
