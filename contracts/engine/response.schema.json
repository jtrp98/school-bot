{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "School Bot common engine response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "status"],
  "properties": {
    "protocol": { "const": "1.0" },
    "request_id": { "type": "string", "maxLength": 128 },
    "status": { "enum": ["success", "error"] },
    "data": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "required": ["error"], "not": { "required": ["data"] } },
      "else": { "not": { "required": ["error"] } }
    }
  ],
  "$defs": {
    "errorCode": {
      "description": "Consumers decide by code, never by message text. Engines send the first group, the desktop host the second; the third is sent by the demo engine only.",
      "enum": [
        "PROTOCOL_INVALID",
        "INVALID_REQUEST",
        "INVALID_INPUT",
        "ACTION_UNKNOWN",
        "SAFETY_LIMIT",
        "TRANSPORT_ERROR",
        "DEVICE_TIMEOUT",
        "PROJECT_INVALID",
        "ENGINE_BUSY",
        "ENGINE_CANCELLED",
        "ENGINE_FAILED",
        "ENGINE_TIMEOUT",
        "PROGRAM_INVALID",
        "COMMAND_UNKNOWN",
        "STEP_LIMIT"
      ]
    }
  }
}
