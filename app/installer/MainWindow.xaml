<Window x:Class="SchoolBot.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" Height="620" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        Icon="Assets/appicon.ico" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Closing="OnClosing" Loaded="OnLoaded">
  <Window.Resources>
    <Storyboard x:Key="FloatAnimation" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="RobotFloat" Storyboard.TargetProperty="Y"
                       From="0" To="-12" Duration="0:0:2.4">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="SparkFloat" Storyboard.TargetProperty="Y"
                       From="0" To="10" Duration="0:0:2.4" />
    </Storyboard>
    <Storyboard x:Key="InstallingAnimation" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="OrbitRotation" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:5" />
      <DoubleAnimation Storyboard.TargetName="BusyDot" Storyboard.TargetProperty="Opacity"
                       From="0.3" To="1" Duration="0:0:0.8" AutoReverse="True" />
    </Storyboard>
  </Window.Resources>
  <Viewbox Stretch="Uniform" TextElement.Foreground="{StaticResource Ink}">
  <Grid Width="896" Height="596" Margin="12">
    <Border CornerRadius="26" Background="White">
      <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.13" Color="#243F60" /></Border.Effect>
    </Border>
    <Border CornerRadius="26" Background="White" ClipToBounds="True" MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border CornerRadius="26,0,0,26">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
              <GradientStop Color="#DFF3FF" Offset="0" /><GradientStop Color="#F2F9FF" Offset="0.65" />
              <GradientStop Color="#FFF0E4" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid ClipToBounds="True">
            <Ellipse Width="338" Height="338" Fill="White" Opacity="0.78" Margin="-15,-25,0,0" />
            <Ellipse Width="288" Height="288" Stroke="#C6E8F9" StrokeThickness="1.5" Margin="0,-35,0,0" />
            <Ellipse Width="224" Height="224" Stroke="#D7EDF9" StrokeThickness="1.5" Margin="0,-35,0,0" />
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="30,30,0,0"
                    Background="#BAFFFFFF" CornerRadius="14" Padding="12,6">
              <TextBlock x:Name="EditionLabel" FontSize="11" FontWeight="SemiBold" Foreground="#39738E" />
            </Border>
            <Ellipse Width="28" Height="28" Fill="#FFA465" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="36,133,0,0" Opacity="0.65" />
            <Ellipse Width="12" Height="12" Fill="#65C7EC" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,100,42,0" />
            <Image Source="Assets/hero.png" Width="226" Height="326" Margin="0,-15,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
              <Image.RenderTransform><TranslateTransform x:Name="RobotFloat" /></Image.RenderTransform>
            </Image>
            <Border Width="64" Height="58" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,164,23,0" Background="White" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><TranslateTransform x:Name="SparkFloat" /></Border.RenderTransform>
              <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.08" /></Border.Effect>
              <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                         Foreground="#0066CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Grid x:Name="Orbit" Width="68" Height="68" HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" Margin="28,0,0,142" Visibility="Collapsed">
              <Grid.RenderTransform><RotateTransform x:Name="OrbitRotation" CenterX="34" CenterY="34" /></Grid.RenderTransform>
              <Ellipse Stroke="#72C9EE" StrokeThickness="2" StrokeDashArray="2,5" />
              <Ellipse Width="10" Height="10" Fill="#FF8B4E" VerticalAlignment="Top" />
            </Grid>
            <StackPanel VerticalAlignment="Bottom" Margin="30,0,26,30">
              <TextBlock x:Name="HeroTitle" FontSize="24" FontWeight="SemiBold" LineHeight="34" />
              <TextBlock x:Name="HeroDescription" Margin="0,9,0,0" FontSize="13" Foreground="#5F8296" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="42,54,38,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="62" /><RowDefinition Height="24" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Image Source="Assets/wordmark.png" Width="344" HorizontalAlignment="Left"
                 VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Row="2">
            <TextBlock x:Name="Heading" FontSize="32" FontWeight="SemiBold" LineHeight="43" />
            <TextBlock x:Name="Description" FontSize="15" Foreground="{StaticResource Muted}"
                       LineHeight="26" Margin="0,16,0,0" />
            <Border x:Name="Labs" Background="#F3F7FB" CornerRadius="12" Padding="13,11" Margin="0,22,0,0">
              <TextBlock x:Name="Modes" FontSize="13" Foreground="#53728C" />
            </Border>
            <StackPanel x:Name="ProgressPanel" Margin="0,25,0,0" Visibility="Collapsed">
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse x:Name="BusyDot" Width="7" Height="7" Fill="#009CE4" Margin="0,0,9,0" />
                <TextBlock x:Name="ProgressLabel" Grid.Column="1" FontSize="13" Foreground="#53728C" />
              </Grid>
              <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" />
              <TextBlock x:Name="ProgressNote" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
            </StackPanel>
            <CheckBox x:Name="LaunchOption" IsChecked="True" Margin="0,26,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorDetail" Margin="0,14,0,0" FontSize="12" MaxHeight="110"
                       TextTrimming="CharacterEllipsis" Foreground="#B74438" Visibility="Collapsed" />
          </StackPanel>
          <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PrimaryButton" MinHeight="54" Click="OnPrimary" IsDefault="True" />
            <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource QuietButton}"
                    MinHeight="54" Padding="18,12" Click="OnCancel" />
          </Grid>
          <TextBlock x:Name="Footer" Grid.Row="4" FontSize="11" Foreground="#94A3B3" Margin="0,17,0,0" />
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,12,14,0">
          <Button x:Name="MinimizeButton" Style="{StaticResource QuietButton}" Background="Transparent"
                  Padding="11,4" Click="OnMinimize">
            <Path Data="M 0,5 L 12,5" Stroke="#68788D" StrokeThickness="1.5" Width="12" Height="12" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource QuietButton}" Background="Transparent"
                  Padding="11,4" Click="OnCancel">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#68788D" StrokeThickness="1.5" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Viewbox>
</Window>
