    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
