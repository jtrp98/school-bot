{
  "$schema": "../../contracts/engine/manifest.schema.json",
  "id": "mixly",
  "version": "0.1.0",
  "language": "Go + upstream Mixly JavaScript generators",
  "protocol": "1.0",
  "modes": ["block-programming", "coding-adventure"],
  "transport": "stdio-json-lines",
  "default_device_transport": "dry-run",
  "entrypoints": {
    "windows": "mixly-engine.exe",
    "darwin": "mixly-engine",
    "linux": "mixly-engine"
  },
  "hardware_platforms": ["windows", "darwin", "linux"],
  "source": "sb-app-mixly/resources/app/src",
  "integration": "desktop host routes Block Lab (UNO) code generation, compile, upload, the port list and the Serial monitor session; bundled with the desktop app and its Arduino libraries"
}
